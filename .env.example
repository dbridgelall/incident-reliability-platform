# ============================================================
# PostgreSQL Configuration
# ============================================================

# Production / Hosted PostgreSQL
# Use a connection string provided by the database provider.
# Example:
# DATABASE_URL=postgresql://username:password@host/database
#
# Do not commit real database credentials to source control.
DATABASE_URL=


# Local Development
# Used when DATABASE_URL is not defined.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=incident_reliability
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password